<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions for robot control (USB / Bluetooth) -->
    <uses-permission android:name="android.permission.USB_HOST" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />  <!-- For voice input -->

    <!-- USB host feature (required=false so app works on devices without USB host) -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:name=".PhoneRobotApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhoneRobot">

        <!-- GPU native libraries for LiteRT-LM -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PhoneRobot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <activity
            android:name=".ui.ScriptListActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneRobot" />
        <activity
            android:name=".ui.ScriptEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneRobot" />
        <activity
            android:name=".RobotModeActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneRobot" />

    </application>

</manifest>
